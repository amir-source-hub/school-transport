NODE_ENV=development
PORT=5000
HOST=0.0.0.0

DATABASE_URL=postgresql://school_transport:school_transport_dev@127.0.0.1:5433/school_transport
REDIS_URL=redis://:redis_dev_password@127.0.0.1:6379
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
# Use verify-full whenever PostgreSQL is reached over an untrusted network.
PG_SSL_MODE=disable
READINESS_TIMEOUT_MS=2000

# Local development only. Production secrets must come from the deployment secret store.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
JWT_REMEMBER_REFRESH_TOKEN_TTL=604800

ADMIN_JWT_ACCESS_TOKEN_TTL=3600
ADMIN_JWT_REFRESH_TOKEN_TTL=86400
ADMIN_JWT_REMEMBER_REFRESH_TOKEN_TTL=604800
ADMIN_CHALLENGE_TTL_SECONDS=300

OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ONBOARDING_SESSION_TTL_SECONDS=604800
FEATURE_ADMIN_2FA=true
FEATURE_ONBOARDING=true
API_DOCS_ENABLED=true

CORS_ORIGINS=http://localhost:3000
# Comma-separated IP/CIDR allowlist for the directly connected reverse proxy.
# Leave empty when clients connect directly. Never use a catch-all range such as 0.0.0.0/0.
# Docker Compose uses Caddy's isolated fixed address, 172.30.20.2/32; use that value only
# when running on the repository's proxy_api network.
TRUSTED_PROXY_CIDRS=

LOG_LEVEL=debug
OTP_PROVIDER=kavenegar
SMS_PROVIDER=kavenegar
KAVEHNEGAR_API_KEY=
KAVEHNEGAR_BASE_URL=https://api.kavenegar.com/v1
KAVEHNEGAR_SENDER=
KAVEHNEGAR_OTP_TEMPLATE=schooltransportotp
KAVEHNEGAR_TIMEOUT_MS=5000
PAYMENT_GATEWAY_PROVIDER=mock
SERVICE_ROLE=api
AUTH_SESSION_RETENTION_DAYS=30
QUEUE_REQUIRED=false
SEED_DEMO_DATA=false
