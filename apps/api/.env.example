NODE_ENV=development
PORT=5000
HOST=0.0.0.0

DATABASE_URL=postgresql://school_transport:school_transport_dev@127.0.0.1:5433/school_transport
REDIS_URL=redis://:redis_dev_password@127.0.0.1:6379
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000
# Use verify-full whenever PostgreSQL is reached over an untrusted network.
PG_SSL_MODE=disable
READINESS_TIMEOUT_MS=2000

# Local development only. Production secrets must come from the deployment secret store.
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
JWT_REMEMBER_REFRESH_TOKEN_TTL=604800

ADMIN_JWT_ACCESS_TOKEN_TTL=3600
ADMIN_JWT_REFRESH_TOKEN_TTL=86400
ADMIN_JWT_REMEMBER_REFRESH_TOKEN_TTL=604800
ADMIN_CHALLENGE_TTL_SECONDS=300
SEED_ADMIN_PASSWORD=demo-admin-password

OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ONBOARDING_SESSION_TTL_SECONDS=604800
FEATURE_ADMIN_2FA=true
FEATURE_ONBOARDING=true
API_DOCS_ENABLED=true

CORS_ORIGINS=http://localhost:3000
# Comma-separated IP/CIDR allowlist for the directly connected reverse proxy.
# Leave empty when clients connect directly. Never use a catch-all range such as 0.0.0.0/0.
# Docker Compose uses Caddy's isolated fixed address, 172.30.20.2/32; use that value only
# when running on the repository's proxy_api network.
TRUSTED_PROXY_CIDRS=

LOG_LEVEL=debug
# Safe local defaults. Production validation rejects console OTP and requires
# Kavenegar credentials whenever the Kavenegar providers are enabled.
OTP_PROVIDER=console
SMS_PROVIDER=none
KAVEHNEGAR_API_KEY=
KAVEHNEGAR_BASE_URL=https://api.kavenegar.com/v1
KAVEHNEGAR_SENDER=
KAVEHNEGAR_OTP_TEMPLATE=schooltransportotp
KAVEHNEGAR_TIMEOUT_MS=5000
FEATURE_SMS_BROADCASTS=false
SMS_BROADCAST_BATCH_SIZE=50
SMS_BROADCAST_MAX_RECIPIENTS=5000
SMS_BROADCAST_MAX_SEGMENTS=3
SMS_BROADCAST_PRICE_PER_SEGMENT_RIAL=0
SMS_BROADCAST_MAX_COST_RIAL=0
SMS_BROADCAST_TEST_NUMBERS=
PAYMENT_GATEWAY_PROVIDER=none

# ArvanCloud S3-compatible object storage for student card photos. Fill all five
# values together to enable uploads; production requires real bucket credentials.
ARVAN_S3_ENDPOINT=
ARVAN_S3_REGION=
ARVAN_S3_BUCKET=
ARVAN_S3_ACCESS_KEY=
ARVAN_S3_SECRET_KEY=
PUBLIC_ASSET_BUCKET=
STUDENT_PHOTO_UPLOAD_URL_TTL_SECONDS=300
STUDENT_PHOTO_VIEW_URL_TTL_SECONDS=300
STUDENT_PHOTO_MAX_BYTES=5242880
STUDENT_PHOTO_MAX_PIXELS=12500000
STUDENT_PHOTO_MAX_AXIS=8000
STUDENT_PHOTO_OUTPUT_WIDTH=600
STUDENT_PHOTO_OUTPUT_HEIGHT=800
STUDENT_PHOTO_JPEG_QUALITY=85
STUDENT_PHOTO_MAX_ACTIVE_UPLOADS=3

SERVICE_ROLE=api
AUTH_SESSION_RETENTION_DAYS=30
QUEUE_REQUIRED=false
SEED_DEMO_DATA=false
