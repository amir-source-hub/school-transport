{
  "name": "@school-transport/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node --env-file=.env --import tsx src/database/migrate.ts",
    "db:seed": "node --env-file=.env --import tsx src/database/seed.ts",
    "db:bootstrap": "node --env-file=.env --import tsx src/database/bootstrap-db.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.0.0",
    "argon2": "^0.41.0",
    "bullmq": "^5.80.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^3.6.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "5.10.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sharp": "0.35.0",
    "uuid": "^11.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^8.57.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
