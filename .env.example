# Copy values into app-specific local environment files. Never commit real secrets.

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Public, credential-free base for immutable website assets (no trailing slash).
# Production example: https://assets.samingasht.ir/public/site/<release-id>
NEXT_PUBLIC_ASSET_BASE_URL=https://samingasht-public-production.s3.ir-thr-at1.arvanstorage.ir/public/site/release-2026-08-12
API_INTERNAL_BASE_URL=http://api:5000/api/v1
# Production builds: immutable release ID plus a secret base64 AES key shared by every replica.
NEXT_DEPLOYMENT_ID=development-local
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
NEXT_PUBLIC_FEATURE_ADMIN_2FA=true
NEXT_PUBLIC_FEATURE_ONBOARDING=true
NEXT_PUBLIC_FEATURE_STUDENT_PANEL=true
MAP_TILE_BASE_URL=https://tile.openstreetmap.org
MAP_TILE_CONTACT_URL=https://samingasht.ir/contact
API_DOCS_ENABLED=true

# API
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DATABASE_URL=postgresql://school_transport:school_transport_dev@127.0.0.1:5433/school_transport
TEST_DATABASE_URL=postgresql://school_transport:school_transport_dev@127.0.0.1:5433/school_transport_test
REDIS_URL=redis://:redis_dev_password@127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
JWT_REMEMBER_REFRESH_TOKEN_TTL=604800
ADMIN_JWT_ACCESS_TOKEN_TTL=3600
ADMIN_JWT_REFRESH_TOKEN_TTL=86400
ADMIN_JWT_REMEMBER_REFRESH_TOKEN_TTL=604800
ADMIN_CHALLENGE_TTL_SECONDS=300
SEED_ADMIN_PASSWORD=demo-admin-password
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ONBOARDING_SESSION_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
METRICS_BEARER_TOKEN=
# Safe local defaults. Set both to kavenegar only in an ignored local .env or
# deployment secret configuration after supplying the required credentials.
OTP_PROVIDER=console
SMS_PROVIDER=none
KAVEHNEGAR_API_KEY=
KAVEHNEGAR_BASE_URL=https://api.kavenegar.com/v1
KAVEHNEGAR_SENDER=
KAVEHNEGAR_OTP_TEMPLATE=schooltransportotp
KAVEHNEGAR_TIMEOUT_MS=5000
FEATURE_SMS_BROADCASTS=false
SMS_BROADCAST_BATCH_SIZE=50
SMS_BROADCAST_MAX_RECIPIENTS=5000
SMS_BROADCAST_MAX_SEGMENTS=3
SMS_BROADCAST_PRICE_PER_SEGMENT_RIAL=0
SMS_BROADCAST_MAX_COST_RIAL=0
SMS_BROADCAST_TEST_NUMBERS=
PAYMENT_GATEWAY_PROVIDER=none
ARVAN_S3_ENDPOINT=
ARVAN_S3_REGION=
ARVAN_S3_BUCKET=
ARVAN_S3_ACCESS_KEY=
ARVAN_S3_SECRET_KEY=
# Public website bucket uses the same Arvan S3 endpoint, region, and credentials.
PUBLIC_ASSET_BUCKET=
NEXT_PUBLIC_PRIVATE_UPLOAD_ORIGIN=https://s3.ir-thr-at1.arvanstorage.ir
STUDENT_PHOTO_UPLOAD_URL_TTL_SECONDS=300
STUDENT_PHOTO_VIEW_URL_TTL_SECONDS=300
STUDENT_PHOTO_MAX_BYTES=5242880
STUDENT_PHOTO_MAX_PIXELS=12500000
STUDENT_PHOTO_MAX_AXIS=8000
STUDENT_PHOTO_OUTPUT_WIDTH=600
STUDENT_PHOTO_OUTPUT_HEIGHT=800
STUDENT_PHOTO_JPEG_QUALITY=85
STUDENT_PHOTO_MAX_ACTIVE_UPLOADS=3
SERVICE_ROLE=api
AUTH_SESSION_RETENTION_DAYS=30
QUEUE_REQUIRED=false
