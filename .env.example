# Copy values into app-specific local environment files. Never commit real secrets.

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# API
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/school_transport
TEST_DATABASE_URL=postgresql://school_transport:school_transport_dev@localhost:5432/school_transport_test
REDIS_URL=redis://:redis_dev_password@localhost:6379
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000
ADMIN_JWT_ACCESS_TOKEN_TTL=600
ADMIN_JWT_REFRESH_TOKEN_TTL=28800
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
OTP_PROVIDER=console
PAYMENT_GATEWAY_PROVIDER=mock
SERVICE_ROLE=api
