# Copy values into app-specific local environment files. Never commit real secrets.

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
API_INTERNAL_BASE_URL=http://api:5000/api/v1
# Production builds: immutable release ID plus a secret base64 AES key shared by every replica.
NEXT_DEPLOYMENT_ID=development-local
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
NEXT_PUBLIC_FEATURE_ADMIN_2FA=true
NEXT_PUBLIC_FEATURE_ONBOARDING=true
NEXT_PUBLIC_FEATURE_STUDENT_PANEL=true
MAP_TILE_BASE_URL=https://tile.openstreetmap.org
MAP_TILE_CONTACT_URL=https://samingasht.ir/contact
API_DOCS_ENABLED=true

# API
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
DATABASE_URL=postgresql://school_transport:school_transport_dev@127.0.0.1:5433/school_transport
TEST_DATABASE_URL=postgresql://school_transport:school_transport_dev@127.0.0.1:5433/school_transport_test
REDIS_URL=redis://:redis_dev_password@127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400
JWT_REMEMBER_REFRESH_TOKEN_TTL=604800
ADMIN_JWT_ACCESS_TOKEN_TTL=3600
ADMIN_JWT_REFRESH_TOKEN_TTL=86400
ADMIN_JWT_REMEMBER_REFRESH_TOKEN_TTL=604800
ADMIN_CHALLENGE_TTL_SECONDS=300
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ONBOARDING_SESSION_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
OTP_PROVIDER=kavenegar
SMS_PROVIDER=kavenegar
KAVEHNEGAR_API_KEY=
KAVEHNEGAR_BASE_URL=https://api.kavenegar.com/v1
KAVEHNEGAR_SENDER=
KAVEHNEGAR_OTP_TEMPLATE=schooltransportotp
KAVEHNEGAR_TIMEOUT_MS=5000
PAYMENT_GATEWAY_PROVIDER=mock
SERVICE_ROLE=api
AUTH_SESSION_RETENTION_DAYS=30
QUEUE_REQUIRED=false
