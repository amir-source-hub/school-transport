# Copy to .env.monitoring for local validation only. Production should use a protected file such as
# /etc/school-transport/monitoring.env. Never commit a populated monitoring environment file.

DEPLOY_ENV=production
RELEASE_ID=replace-with-immutable-release-id
APPLICATION_BACKEND_NETWORK=school-transport-production_backend
POSTGRES_DB=school_transport

# Must exactly match METRICS_BEARER_TOKEN in the API production environment.
METRICS_BEARER_TOKEN=replace-with-at-least-32-random-characters

PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB
PROMETHEUS_HOST_PORT=9090

POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=replace-with-at-least-32-random-characters
REDIS_EXPORTER_PASSWORD_MAP={"redis://redis:6379":"replace-with-the-real-redis-password"}

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-at-least-20-random-characters
GRAFANA_HOST_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001

# Create the bot with Bale's @botfather, add it to the destination, and use the numeric chat ID.
BALE_BOT_TOKEN=replace-with-the-real-bale-bot-token
BALE_CHAT_ID=replace-with-the-numeric-bale-chat-id
ALERTMANAGER_HOST_PORT=9093
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
ALERTMANAGER_RETENTION_TIME=120h
