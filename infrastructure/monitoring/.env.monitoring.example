# Copy to .env.monitoring for local validation only. Production should use a protected file such as
# /etc/school-transport/monitoring.env. Never commit real credentials or secret-file contents.

DEPLOY_ENV=production
RELEASE_ID=replace-with-immutable-release-id
APPLICATION_BACKEND_NETWORK=school-transport-production_backend
POSTGRES_DB=school_transport

# File content must exactly match the API METRICS_BEARER_TOKEN.
METRICS_BEARER_TOKEN_FILE=/etc/school-transport/secrets/metrics-bearer-token

PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB
PROMETHEUS_HOST_PORT=9090

POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD_FILE=/etc/school-transport/secrets/postgres-exporter-password
REDIS_EXPORTER_PASSWORD_MAP_FILE=/etc/school-transport/secrets/redis-exporter-password-map.json

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD_FILE=/etc/school-transport/secrets/grafana-admin-password
GRAFANA_HOST_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001

# Keep this path configured, but create/populate the protected file only when alert delivery is ready.
ALERT_WEBHOOK_URL_FILE=/etc/school-transport/secrets/alert-webhook-url
ALERTMANAGER_HOST_PORT=9093
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
ALERTMANAGER_RETENTION_TIME=120h
