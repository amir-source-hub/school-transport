# Public, non-secret production-mode fixture used only by Deployment CI.
NODE_ENV=production
DEPLOYMENT_PROFILE=production
APP_DOMAIN=samingasht.ir
ACME_EMAIL=ci@example.invalid
PORT=5000
HOST=0.0.0.0
DATABASE_URL=postgresql://school_transport:ci-only-postgres-password@postgres:5432/school_transport
REDIS_URL=redis://:ci-only-redis-password@redis:6379
JWT_SECRET=ci-only-deployment-secret-with-at-least-32-characters
API_DOCS_ENABLED=false
CORS_ORIGINS=https://samingasht.ir
TRUSTED_PROXY_CIDRS=172.30.20.2/32
LOG_LEVEL=info
METRICS_BEARER_TOKEN=ci-only-metrics-token-with-at-least-32-characters
OTP_PROVIDER=kavenegar
SMS_PROVIDER=none
KAVEHNEGAR_API_KEY=ci-only-provider-key
KAVEHNEGAR_OTP_TEMPLATE=ci_test_template
FEATURE_SMS_BROADCASTS=false
PAYMENT_GATEWAY_PROVIDER=none
SEED_DEMO_DATA=false
QUEUE_REQUIRED=true
NEXT_PUBLIC_API_BASE_URL=https://samingasht.ir/api/v1
NEXT_PUBLIC_ASSET_BASE_URL=https://assets.example.invalid/public/site/ci
NEXT_PUBLIC_PRIVATE_UPLOAD_ORIGIN=https://s3.example.invalid
API_INTERNAL_BASE_URL=http://api:5000/api/v1
NEXT_DEPLOYMENT_ID=ci-build
NEXT_PUBLIC_FEATURE_ADMIN_2FA=true
NEXT_PUBLIC_FEATURE_ONBOARDING=true
NEXT_PUBLIC_FEATURE_STUDENT_PANEL=true
MAP_TILE_BASE_URL=https://tile.openstreetmap.org
MAP_TILE_CONTACT_URL=https://samingasht.ir/contact
