# Install on a separate recovery host as /etc/school-transport/restore-validation.env (0640).
BACKUP_REMOTE_BUCKET=replace-with-private-backup-bucket
BACKUP_MONTHLY_REMOTE_BUCKET=replace-with-private-monthly-archive-bucket
BACKUP_REMOTE_PREFIX=production/postgresql
BACKUP_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
BACKUP_S3_REGION=ir-thr-at1
BACKUP_AGE_IDENTITY_FILE=/etc/school-transport/keys/backup-age-identity.txt
RESTORE_VALIDATION_DIR=/var/lib/school-transport/restore-validation
RESTORE_VALIDATION_LOCK_FILE=/var/lib/school-transport/restore-validation/.lock
BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile_collector
RESTORE_POSTGRES_IMAGE=postgres:16-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
AWS_ACCESS_KEY_ID=replace-with-read-only-backup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-read-only-backup-secret-key
