# Install as /etc/school-transport/backup.env owned by root, group-readable only by the backup
# service account (0640). Never commit real values.
# docker-compose mode reads POSTGRES_USER/POSTGRES_DB inside the running database container and
# does not expose PostgreSQL on a host port. Use direct mode only for a separately reachable database.
BACKUP_DATABASE_MODE=docker-compose
BACKUP_COMPOSE_FILE=/srv/school-transport/docker-compose.production.yml
BACKUP_COMPOSE_PROJECT_DIRECTORY=/srv/school-transport
BACKUP_POSTGRES_SERVICE=postgres
# DATABASE_URL=postgresql://backup_user:replace-me@database-host:5432/school_transport
DEPLOY_ENV=production
CONFIRM_PRODUCTION_BACKUP=BACKUP_ONLY
RELEASE_ID=replace-with-current-release-id
BACKUP_AGE_RECIPIENT=age1replacewithpublicrecipient
BACKUP_OUTPUT_DIR=/var/lib/school-transport/backups
BACKUP_LOCAL_RETENTION_HOURS=48
BACKUP_MINIMUM_BYTES=1024
BACKUP_LOCK_FILE=/var/lib/school-transport/backups/.backup.lock
BACKUP_REMOTE_BUCKET=replace-with-private-backup-bucket
BACKUP_MONTHLY_REMOTE_BUCKET=replace-with-private-monthly-archive-bucket
BACKUP_REMOTE_PREFIX=production/postgresql
BACKUP_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
BACKUP_S3_REGION=ir-thr-at1
BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile_collector
AWS_ACCESS_KEY_ID=replace-with-upload-only-access-key
AWS_SECRET_ACCESS_KEY=replace-with-upload-only-secret-key
