# Separate cleanup identity. It requires list/read/delete-version access only to the two backup buckets.
BACKUP_REMOTE_BUCKET=samingasht-production-db-backup-rolling
BACKUP_MONTHLY_REMOTE_BUCKET=samingasht-production-db-backup-monthly
BACKUP_REMOTE_PREFIX=production/postgresql
BACKUP_S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
BACKUP_S3_REGION=ir-thr-at1
BACKUP_ROLLING_RETENTION_DAYS=35
BACKUP_MONTHLY_RETENTION_DAYS=400
BACKUP_RETENTION_STATE_DIR=/var/lib/school-transport/backup-retention
BACKUP_RETENTION_LOCK_FILE=/var/lib/school-transport/backup-retention/.cleanup.lock
BACKUP_METRICS_DIR=/var/lib/node_exporter/textfile_collector
AWS_ACCESS_KEY_ID=replace-with-retention-cleanup-access-key
AWS_SECRET_ACCESS_KEY=replace-with-retention-cleanup-secret-key
