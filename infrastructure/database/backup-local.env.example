# Local backups only. No AWS, age, monitoring, or project-directory access required.
BACKUP_STORAGE_MODE=local
CONFIRM_PRODUCTION_BACKUP=BACKUP_ONLY
BACKUP_POSTGRES_CONTAINER=school-transport-production-postgres-1
BACKUP_OUTPUT_DIR=/var/lib/school-transport/backups
BACKUP_LOCAL_RETENTION_HOURS=168
# Refuse to start when less than 1 GiB is free.
BACKUP_MIN_FREE_KB=1048576
