# Operator-only Arvan management configuration. Never install this on the backup service account.
# Supply the complete header value expected by Arvan, for example the value issued by the panel.
ARVAN_API_AUTHORIZATION=replace-with-complete-authorization-header-value
ARVAN_BACKUP_REGION=ir-central1
# Suggested names; confirm global availability in the shared Arvan account.
ARVAN_ROLLING_BACKUP_BUCKET=samingasht-production-db-backup-rolling
ARVAN_MONTHLY_BACKUP_BUCKET=samingasht-production-db-backup-monthly
ARVAN_ROLLING_LOCK_DAYS=35
ARVAN_MONTHLY_LOCK_DAYS=400
