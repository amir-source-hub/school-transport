{
  "name": "school-transport-platform",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "env:check": "node infrastructure/config/assert-environment-inventory.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:list": "pnpm --filter web test:e2e:list"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "vite@<=6.4.2": "6.4.3",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "find-my-way@<=9.6.0": "9.7.0",
      "js-yaml@<4.3.1": "4.3.1",
      "lodash@<=4.17.23": "4.18.0",
      "path-to-regexp@>=8.0.0 <8.4.0": "8.4.0",
      "postcss@<=8.5.22": "8.5.23",
      "sharp@<0.35.0": "0.35.0",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
